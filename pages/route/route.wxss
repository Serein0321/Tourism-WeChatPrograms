.route-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-card {
  padding: 26rpx;
}

.route-title {
  font-size: 32rpx;
  font-weight: 800;
}

.route-time {
  margin-top: 8rpx;
  color: #f49b2f;
  font-size: 24rpx;
  font-weight: 700;
}

.stop-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
