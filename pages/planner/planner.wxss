/* ======== 页面容器 ======== */
.planner-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8faf9;
}

/* ======== 1. 顶部地图区 ======== */
.map-shell {
  flex: 0 0 auto;
  height: 40%;
  min-height: 320rpx;
  max-height: 500rpx;
  background: linear-gradient(135deg, #e8f4f1 0%, #f0f8f6 100%);
  border-radius: 0 0 28rpx 28rpx;
  overflow: hidden;
  position: relative;
}

.map-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
}

/* ======== 2. 对话面板（底部固定） ======== */
.agent-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 320ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 10;
  overflow: hidden;
}

/* collapsed 态：半开约 40% 屏幕 */
.agent-panel.collapsed {
  max-height: 320rpx;
}

/* expanded 态：全开约 90% 屏幕 */
.agent-panel.expanded {
  max-height: 100%;
}

/* transitioning 态：过渡中 */
.agent-panel.transitioning {
  pointer-events: none;
}

/* ======== 3. Panel Grabber（短横线） ======== */
.panel-grabber {
  flex: 0 0 auto;
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #d7e7e0 0%, #c5ddd5 100%);
  cursor: grab;
  transition: all 200ms ease;
}

.agent-panel:active .panel-grabber {
  background: linear-gradient(90deg, #b8d3ca 0%, #a5c8be 100%);
}

/* ======== 4. Panel Header（新对话入口） ======== */
.panel-header {
  flex: 0 0 auto;
  padding: 12rpx 24rpx 12rpx 24rpx;
  border-bottom: 1rpx solid #e8f0ed;
}

.new-chat-entry {
  display: inline-block;
  font-size: 28rpx;
  color: #27b37e;
  font-weight: 600;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  transition: all 180ms ease;
  cursor: pointer;
}

.new-chat-entry:active {
  background: rgba(39, 179, 126, 0.1);
  transform: scale(0.95);
}

/* ======== Panel CTA（半开态醒目按钮） ======== */
.panel-cta {
  flex: 0 0 auto;
  align-self: center;
  margin: 20rpx auto;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #27b37e 0%, #1d8f6a 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 16rpx rgba(39, 179, 126, 0.3);
  transition: all 120ms cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.panel-cta:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 8rpx rgba(39, 179, 126, 0.2);
}

/* ======== 5. 消息列表 ======== */
.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  scroll-behavior: smooth;
}

.message-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 8rpx;
  animation: slideIn 180ms cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* user 消息气泡 */
.message-item .message-role {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.message-item .message-content {
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #e8f4f1 0%, #f0f8f6 100%);
  color: #24443c;
  font-size: 28rpx;
  line-height: 1.5;
  border-radius: 16rpx;
  word-wrap: break-word;
  word-break: break-word;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* assistant 消息气泡 */
.assistant-message .message-content {
  background: linear-gradient(135deg, #3aa8f5 0%, #2a8fe5 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(58, 168, 245, 0.2);
}

.user-message .message-content {
  background: linear-gradient(135deg, #e8f4f1 0%, #f0f8f6 100%);
  color: #24443c;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ======== 6. Tool Tabs（横向滚动） ======== */
.tool-tabs {
  flex: 0 0 auto;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  overflow-x: auto;
  scroll-behavior: smooth;
  border-top: 1rpx solid #e8f0ed;
  -webkit-overflow-scrolling: touch;
}

.tool-tab {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  background: #f0f8f6;
  color: #507269;
  font-size: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
  white-space: nowrap;
  transition: all 200ms ease;
  cursor: pointer;
}

.tool-tab:active {
  transform: scale(0.96);
}

/* active 态 */
.tool-tab.active {
  background: linear-gradient(135deg, #27b37e 0%, #1d8f6a 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(39, 179, 126, 0.2);
  border-color: transparent;
}

/* ======== 7. Chat Composer（输入区固定在面板底部） ======== */
.chat-composer {
  flex: 0 0 auto;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e8f0ed;
  align-items: center;
}

.composer-input {
  flex: 1;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  border: 1rpx solid #d7e7e0;
  border-radius: 20rpx;
  background: #f8faf9;
  color: #24443c;
  transition: all 200ms ease;
  box-sizing: border-box;
}

.composer-input:focus {
  border-color: #27b37e;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(39, 179, 126, 0.1);
}

.composer-send {
  flex: 0 0 auto;
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #27b37e 0%, #1d8f6a 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  text-align: center;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  box-shadow: 0 4rpx 12rpx rgba(39, 179, 126, 0.2);
}

.composer-send:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(39, 179, 126, 0.15);
}

/* ======== 8. 移动端适配 ======== */
@media (max-width: 600px) {
  .planner-page {
    height: 100vh;
    overflow: hidden;
  }

  .map-shell {
    min-height: 280rpx;
    max-height: 400rpx;
  }

  .agent-panel {
    border-radius: 28rpx 28rpx 0 0;
  }

  .agent-panel.collapsed {
    max-height: 280rpx;
  }

  .message-list {
    padding: 16rpx 20rpx;
  }

  .tool-tabs {
    padding: 12rpx 20rpx;
  }

  .chat-composer {
    padding: 12rpx 20rpx 20rpx;
    gap: 8rpx;
  }

  .composer-input,
  .composer-send {
    font-size: 26rpx;
    padding: 10rpx 14rpx;
  }

  .panel-grabber {
    margin: 12rpx auto 10rpx;
  }

  .panel-cta {
    padding: 14rpx 28rpx;
    font-size: 28rpx;
    margin: 16rpx auto;
  }
}

