.planner-map-page {
  position: relative;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: #f7fbf6;
  color: #1f2d2a;
}

.map-stage {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 64vh;
  overflow: hidden;
  background: #dcefe7;
}

.map-sdk-placeholder {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #c8e7ff 0%, #9fd1df 30%, #7ec89b 58%, #eaf6e9 100%);
}

.map-sky {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 190rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0));
}

.map-hill {
  position: absolute;
  left: -110rpx;
  right: -110rpx;
  border-radius: 50% 50% 0 0;
}

.hill-far {
  bottom: 294rpx;
  height: 260rpx;
  background: linear-gradient(135deg, rgba(244, 252, 255, 0.9), rgba(91, 147, 132, 0.66) 48%, rgba(39, 87, 76, 0.82));
  transform: rotate(-5deg);
}

.hill-mid {
  bottom: 184rpx;
  height: 246rpx;
  background: linear-gradient(135deg, rgba(139, 203, 134, 0.82), rgba(45, 129, 88, 0.9) 54%, rgba(28, 78, 70, 0.94));
  transform: rotate(6deg);
}

.hill-near {
  bottom: 72rpx;
  height: 220rpx;
  background: linear-gradient(135deg, rgba(252, 232, 172, 0.68), rgba(78, 160, 104, 0.92) 38%, rgba(26, 90, 72, 0.96));
  transform: rotate(-2deg);
}

.map-river {
  position: absolute;
  right: -80rpx;
  bottom: -70rpx;
  left: -80rpx;
  height: 216rpx;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, rgba(123, 205, 204, 0.52), rgba(35, 123, 116, 0.72));
}

.map-route {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 0 0 8rpx rgba(43, 112, 88, 0.16);
}

.route-main {
  right: -40rpx;
  bottom: 176rpx;
  width: 560rpx;
  height: 14rpx;
  transform: rotate(-18deg);
}

.route-branch {
  left: 70rpx;
  bottom: 316rpx;
  width: 390rpx;
  height: 12rpx;
  transform: rotate(18deg);
}

.map-pin {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 22rpx rgba(19, 68, 58, 0.15);
}

.pin-a {
  right: 118rpx;
  bottom: 306rpx;
}

.pin-b {
  left: 108rpx;
  bottom: 254rpx;
}

.pin-c {
  right: 216rpx;
  bottom: 154rpx;
}

.pin-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #30c58c, #22885f);
}

.pin-label {
  color: #24463e;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sdk-placeholder-card {
  position: absolute;
  top: 82rpx;
  left: 34rpx;
  right: 34rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 18rpx 36rpx rgba(30, 88, 76, 0.12);
  backdrop-filter: blur(16rpx);
}

.sdk-placeholder-title {
  color: #193d35;
  font-size: 30rpx;
  font-weight: 800;
}

.sdk-placeholder-desc {
  margin-top: 8rpx;
  color: #5e756e;
  font-size: 24rpx;
  line-height: 1.45;
}

.map-info-card {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 42vh;
  z-index: 2;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 34rpx rgba(27, 80, 66, 0.12);
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 220ms ease, transform 220ms ease;
}

.map-info-card.show {
  opacity: 1;
  transform: translateY(0);
}

.map-info-title {
  color: #203d36;
  font-size: 28rpx;
  font-weight: 800;
}

.map-info-desc {
  margin-top: 6rpx;
  color: #6b7c76;
  font-size: 23rpx;
  line-height: 1.45;
}

.assistant-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 4;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 38rpx 38rpx 0 0;
  background: #f7fbf6;
  box-shadow: 0 -20rpx 48rpx rgba(27, 72, 62, 0.16);
  transition: height 260ms ease;
}

.assistant-sheet.peek {
  height: 52vh;
}

.assistant-sheet.chat {
  height: 88vh;
}

.sheet-drag-area {
  height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.drawer-grabber {
  width: 58rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #c9d4ce;
}

.sheet-drag-copy {
  color: #6e827b;
  font-size: 22rpx;
  line-height: 1;
}

.sheet-preview,
.chat-panel {
  height: calc(100% - 64rpx);
  min-height: 0;
}

.sheet-preview {
  display: flex;
  flex-direction: column;
}

.preview-head,
.chat-head,
.prompt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-kicker,
.chat-kicker {
  color: #27b37e;
  font-size: 24rpx;
  font-weight: 800;
}

.preview-title,
.chat-title {
  margin-top: 8rpx;
  color: #203d36;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
}

.preview-ai {
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #30c58c, #22885f);
  box-shadow: 0 12rpx 24rpx rgba(39, 179, 126, 0.24);
}

.preview-desc {
  margin-top: 16rpx;
  color: #6b7c76;
  font-size: 25rpx;
  line-height: 1.55;
}

.summary-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-card {
  min-height: 102rpx;
  padding: 16rpx 10rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(60, 111, 94, 0.07);
  text-align: center;
  box-sizing: border-box;
}

.summary-value {
  color: #203d36;
  font-size: 30rpx;
  font-weight: 900;
}

.summary-label {
  margin-top: 8rpx;
  color: #748780;
  font-size: 22rpx;
}

.preview-actions,
.tool-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.preview-action,
.tool-card {
  min-height: 116rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(39, 179, 126, 0.12);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(60, 111, 94, 0.07);
  box-sizing: border-box;
}

.preview-action.active,
.tool-card.active {
  border-color: rgba(39, 179, 126, 0.32);
  background: #eef8f3;
}

.preview-action-title,
.tool-card-title {
  color: #203d36;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.2;
}

.preview-action-desc,
.tool-card-desc {
  margin-top: 8rpx;
  color: #748780;
  font-size: 22rpx;
  line-height: 1.42;
}

.preview-composer {
  margin-top: auto;
  min-height: 82rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid rgba(39, 179, 126, 0.18);
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(39, 179, 126, 0.12);
  box-sizing: border-box;
}

.preview-input {
  flex: 1;
  min-width: 0;
  color: #8a9993;
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-send,
.send-button,
.map-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #ffffff;
  font-weight: 800;
  background: linear-gradient(135deg, #30c58c, #22885f);
}

.preview-send {
  width: 104rpx;
  height: 58rpx;
  flex: 0 0 104rpx;
  font-size: 24rpx;
}

.chat-panel {
  display: flex;
  flex-direction: column;
}

.chat-head {
  flex: 0 0 auto;
  padding-bottom: 18rpx;
}

.map-toggle {
  width: 108rpx;
  height: 58rpx;
  flex: 0 0 108rpx;
  font-size: 24rpx;
}

.message-list {
  flex: 1;
  min-height: 0;
}

.tool-grid {
  margin-top: 0;
}

.prompt-section {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 12rpx 28rpx rgba(60, 111, 94, 0.06);
}

.prompt-title {
  color: #203d36;
  font-size: 28rpx;
  font-weight: 800;
}

.refresh-prompts {
  color: #27b37e;
  font-size: 24rpx;
  font-weight: 800;
}

.prompt-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.prompt-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(39, 179, 126, 0.14);
  border-radius: 999rpx;
  background: #f7fbf6;
  color: #42534d;
  font-size: 25rpx;
  line-height: 1.35;
  box-sizing: border-box;
}

.message-stack {
  margin-top: 22rpx;
  padding-bottom: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-item {
  display: flex;
}

.assistant-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.message-content {
  max-width: 84%;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  color: #2b3d37;
  font-size: 25rpx;
  line-height: 1.55;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(60, 111, 94, 0.06);
}

.user-message .message-content {
  color: #ffffff;
  background: linear-gradient(135deg, #30c58c, #22885f);
}

.bottom-tools {
  flex: 0 0 auto;
  margin: 12rpx -28rpx 0;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(39, 179, 126, 0.1);
}

.tool-scroll {
  width: 100%;
  white-space: nowrap;
}

.tool-track {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 28rpx;
}

.tool-pill {
  min-width: 148rpx;
  height: 58rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(39, 179, 126, 0.16);
  border-radius: 999rpx;
  color: #203d36;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffffff;
  box-sizing: border-box;
}

.tool-pill.active {
  color: #179369;
  background: #e9f8f0;
}

.chat-composer {
  flex: 0 0 auto;
  min-height: 96rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid rgba(39, 179, 126, 0.2);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(39, 179, 126, 0.13);
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  color: #203d36;
  font-size: 28rpx;
  line-height: 72rpx;
  background: #f2f8f3;
  box-sizing: border-box;
}

.chat-placeholder {
  color: #9eaaa4;
}

.send-button {
  width: 112rpx;
  height: 72rpx;
  flex: 0 0 112rpx;
  font-size: 28rpx;
}

.preview-action:active,
.tool-card:active,
.prompt-chip:active,
.tool-pill:active,
.preview-composer:active,
.send-button:active,
.map-toggle:active {
  transform: scale(0.98);
}

@media (max-height: 680px) {
  .assistant-sheet.peek {
    height: 56vh;
  }

  .assistant-sheet.chat {
    height: 91vh;
  }

  .preview-desc {
    margin-top: 10rpx;
    font-size: 23rpx;
  }

  .summary-grid,
  .preview-actions {
    margin-top: 14rpx;
  }

  .preview-action,
  .tool-card {
    min-height: 100rpx;
    padding: 15rpx;
  }
}