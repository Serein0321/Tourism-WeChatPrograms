.roam-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #f7fbf6;
  box-sizing: border-box;
}

.hero-visual {
  position: relative;
  height: 790rpx;
  padding: 108rpx 48rpx 46rpx;
  overflow: hidden;
  color: #ffffff;
  box-sizing: border-box;
  border-bottom-left-radius: 42rpx;
  border-bottom-right-radius: 42rpx;
  box-shadow: 0 22rpx 42rpx rgba(28, 73, 68, 0.16);
}

.hero-image-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, #bfe3ff 0%, #8dc4de 28%, #4d8e79 55%, #173d3a 100%);
}

.hero-image-placeholder::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 178rpx;
  height: 300rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(235, 248, 255, 0.66) 18%, rgba(45, 93, 99, 0.34) 19%, rgba(26, 83, 77, 0.55) 54%, rgba(15, 58, 54, 0.86) 100%);
  border-radius: 54% 46% 0 0;
  transform: scaleX(1.25) translateY(24rpx);
}

.hero-ridge {
  position: absolute;
  left: -120rpx;
  right: -120rpx;
  border-radius: 50% 50% 0 0;
}

.hero-ridge-far {
  bottom: 286rpx;
  height: 210rpx;
  background: linear-gradient(135deg, rgba(244, 252, 255, 0.92), rgba(60, 111, 116, 0.5) 44%, rgba(28, 76, 72, 0.78));
  transform: rotate(-4deg);
}

.hero-ridge-near {
  bottom: 146rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(95, 158, 107, 0.76), rgba(24, 82, 64, 0.88) 52%, rgba(13, 55, 52, 0.96));
  transform: rotate(5deg);
}

.hero-water {
  position: absolute;
  left: -80rpx;
  right: -80rpx;
  bottom: -26rpx;
  height: 236rpx;
  background: linear-gradient(180deg, rgba(32, 104, 99, 0.62), rgba(8, 46, 50, 0.92));
  border-radius: 50% 50% 0 0;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(5, 20, 24, 0.05) 0%, rgba(5, 20, 24, 0.16) 42%, rgba(5, 20, 24, 0.5) 100%);
}

.hero-topline,
.hero-title,
.hero-subtitle,
.hero-actions {
  position: relative;
  z-index: 1;
}

.hero-topline {
  font-size: 30rpx;
  line-height: 1.4;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.28);
}

.hero-title {
  width: 86%;
  margin-top: 52rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: 0;
  text-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.28);
}

.hero-subtitle {
  width: 82%;
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.5;
  text-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.24);
}

.hero-actions {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 44rpx;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: end;
  gap: 14rpx;
}

.hero-action {
  height: 142rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #ffffff;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
  backdrop-filter: blur(16rpx);
}

.hero-action.is-active {
  height: 166rpx;
  color: #173d36;
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.18);
}

.hero-action-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-action.is-active .hero-action-icon {
  color: #ffffff;
  background: linear-gradient(135deg, #2db77c, #22885f);
}

.hero-action-text {
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 600;
}

.content-shell {
  padding: 34rpx 28rpx 0;
}

.roam-card {
  padding: 18rpx;
}

.roam-image {
  height: 150rpx;
  border-radius: 22rpx;
  margin-bottom: 18rpx;
}

.roam-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #203d36;
}

.roam-desc {
  margin-top: 8rpx;
  color: #748780;
  font-size: 24rpx;
  line-height: 1.5;
}

.gradient-food {
  background: linear-gradient(135deg, #ffe0b5 0%, #f8a96b 48%, #8bcf9a 100%);
}
